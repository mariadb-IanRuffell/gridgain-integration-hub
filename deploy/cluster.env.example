# =============================================================================
#  cluster.env  —  the ONE place for every hostname, port and credential.
# =============================================================================
#  Physical-server deployment config. Copy this file to  cluster.env  (same
#  directory) and edit the values for your servers:
#
#      cp cluster.env.example cluster.env
#      $EDITOR cluster.env
#
#  cluster.env is git-ignored (it holds real credentials); this .example file
#  is the committed template. Everything else reads these values:
#    - deploy/gridgain-node.sh   starts a GridGain node with these hosts/ports
#    - deploy/load-sources.sh    loads the MariaDB + Oracle schema to these hosts
#    - deploy/with-env.sh        runs any module's ./run.sh with these exported
#    - gridgain/config/node.xml  takes its discovery list from GG_HOST1..3
#
#  This file is sourced by bash, so every var is exported for the Java clients.
# =============================================================================

# ----------------------------------------------------------------------------
#  GridGain cluster — the three server nodes (one per physical host)
# ----------------------------------------------------------------------------
export GG_HOST1=gg1.example.com
export GG_HOST2=gg2.example.com
export GG_HOST3=gg3.example.com

export GG_CLIENT_PORT=10800        # thin-client / JDBC port on every node
export GG_DISCOVERY_PORT=47500     # TCP discovery base port (range :47500..47509)

# Docker image + per-node resources (used by deploy/gridgain-node.sh)
export GG_IMAGE=gridgain/community:8.10.0-b2-openjdk17
export GG_WORK_DIR=/var/lib/gridgain      # host dir for native persistence (per node: $GG_WORK_DIR/nodeN)
export GG_XMS=512m
export GG_XMX=1536m

# ----------------------------------------------------------------------------
#  MariaDB — CRM / customer-360 source
# ----------------------------------------------------------------------------
export MARIADB_HOST=crm-db.example.com
export MARIADB_PORT=3306
export MARIADB_DB=crm
export MARIADB_USER=crm
export MARIADB_PASSWORD=crm
export MARIADB_ROOT_PASSWORD=root         # only used when deploy/load-sources.sh must GRANT, etc.

# ----------------------------------------------------------------------------
#  Oracle — travel / reservations source
# ----------------------------------------------------------------------------
export ORA_HOST=travel-db.example.com
export ORA_PORT=1521
export ORA_SERVICE=FREEPDB1
export ORA_USER=travel
export ORA_PASSWORD=travel
export ORA_SYS_PASSWORD=oracle            # SYS password, for the one-time flashback grant

# ----------------------------------------------------------------------------
#  REST API
# ----------------------------------------------------------------------------
export API_HOST=api.example.com
export API_PORT=8080

# ----------------------------------------------------------------------------
#  CDC reader tuning (optional)
# ----------------------------------------------------------------------------
export CDC_POLL_MS=1000
export CDC_BATCH=5000

# =============================================================================
#  Derived values — DO NOT EDIT. Built from the variables above and consumed by
#  the Java clients, which already read these exact environment-variable names.
# =============================================================================
export GG_ADDRESSES="${GG_HOST1}:${GG_CLIENT_PORT},${GG_HOST2}:${GG_CLIENT_PORT},${GG_HOST3}:${GG_CLIENT_PORT}"
export GG_JDBC="jdbc:ignite:thin://${GG_ADDRESSES}"

export GG_URL="${GG_JDBC}"          # cdc/        (cdc.Main)
export GG_JDBC_URL="${GG_JDBC}"     # api/        (Spring datasource)
export GG_ADDR="${GG_ADDRESSES}"    # phase2/     (compute thin client)
# GG_JDBC itself is used by loadtest/, hub/ and phase2/ parity.

export MARIADB_URL="jdbc:mariadb://${MARIADB_HOST}:${MARIADB_PORT}/${MARIADB_DB}"
export ORA_URL="jdbc:oracle:thin:@//${ORA_HOST}:${ORA_PORT}/${ORA_SERVICE}"
