<?xml version="1.0" encoding="UTF-8"?>
<!-- GridGain node config shared by all three nodes (identity comes from -DNODE_NAME per container).
     - Native persistence on the default data region (data lives in the node's /opt/gridgain/work volume).
       A persistent cluster starts INACTIVE: run ./cluster.sh up (activates once all 3 nodes have joined).
     - Pinned consistentId: a container gets a new IP on recreate, and an IP-derived consistent id would make
       the node look like a stranger to the baseline and orphan its persisted data.
     - Static TCP discovery (multicast does not work between these containers).
     - Thin-client compute enabled (disabled by default). -->
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="grid.cfg" class="org.apache.ignite.configuration.IgniteConfiguration">
        <property name="consistentId" value="#{systemProperties['NODE_NAME']}"/>

        <property name="dataStorageConfiguration">
            <bean class="org.apache.ignite.configuration.DataStorageConfiguration">
                <property name="defaultDataRegionConfiguration">
                    <bean class="org.apache.ignite.configuration.DataRegionConfiguration">
                        <property name="name" value="Default_Region"/>
                        <property name="persistenceEnabled" value="true"/>
                        <property name="initialSize" value="268435456"/>   <!-- 256 MB -->
                        <property name="maxSize" value="1073741824"/>      <!-- 1 GB off-heap per node -->
                    </bean>
                </property>
            </bean>
        </property>

        <property name="discoverySpi">
            <bean class="org.apache.ignite.spi.discovery.tcp.TcpDiscoverySpi">
                <property name="ipFinder">
                    <bean class="org.apache.ignite.spi.discovery.tcp.ipfinder.vm.TcpDiscoveryVmIpFinder">
                        <property name="addresses">
                            <list>
                                <value>gridgain1:47500..47509</value>
                                <value>gridgain2:47500..47509</value>
                                <value>gridgain3:47500..47509</value>
                            </list>
                        </property>
                    </bean>
                </property>
            </bean>
        </property>

        <property name="clientConnectorConfiguration">
            <bean class="org.apache.ignite.configuration.ClientConnectorConfiguration">
                <property name="thinClientConfiguration">
                    <bean class="org.apache.ignite.configuration.ThinClientConfiguration">
                        <property name="maxActiveComputeTasksPerConnection" value="100"/>
                        <property name="sendServerExceptionStackTraceToClient" value="true"/>
                    </bean>
                </property>
            </bean>
        </property>
    </bean>
</beans>
