        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" value="MariaDB + Oracle → GridGain 8.9 Data Hub — Architecture &amp; Data Flows" vertex="1">
