        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#555555;" value="Phase 1: trigger-based CDC (sources stay systems of record).   Phase 2: stored procedures re-implemented as GridGain compute jobs; apps call GridGain." vertex="1">
